{
  "ko_KR": {
    "type": "flex",
    "altText": "Unifi 럭키볼 캠페인 알림",
    "contents": {
      "type": "bubble",
      "hero": {
        "type": "image",
        "url": "{{IMAGE_URL}}",
        "size": "full",
        "aspectRatio": "20:13",
        "aspectMode": "cover"
      },
      "body": {
        "type": "box",
        "layout": "vertical",
        "spacing": "md",
        "contents": [
          {
            "type": "text",
            "text": "가입 완료 당첨금\n{{amount}}JPYC 지급 완료",
            "wrap": true,
            "weight": "bold",
            "size": "xl"
          },
          {
            "type": "text",
            "text": "당첨금 {{amount}}JPYC가 {{wallet_address}}로 지급되었습니다.",
            "wrap": true,
            "size": "sm",
            "color": "#888888"
          }
        ]
      },
      "footer": {
        "type": "box",
        "layout": "vertical",
        "spacing": "sm",
        "contents": [
          {
            "type": "button",
            "style": "primary",
            "action": {
              "type": "uri",
              "label": "홈으로 가기",
              "uri": "{{ACTION_URL}}"
            }
          },
          {
            "type": "button",
            "style": "secondary",
            "action": {
              "type": "uri",
              "label": "확인하기",
              "uri": "{{ACTION_URL}}"
            }
          }
        ]
      }
    }
  },
