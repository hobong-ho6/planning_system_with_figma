{
  "type": "bubble",
  "hero": {
    "type": "image",
    "url": "{{IMAGE_URL}}",
    "size": "full",
    "aspectRatio": "20:13",
    "aspectMode": "cover",
    "action": {
      "type": "uri",
      "uri": "{{ACTION_URL}}"
    }
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "เปิดของขวัญลูกบอลนำโชคเสร็จสิ้น 🎁\nถูกรางวัล {{amount}}JPYC!",
        "weight": "bold",
        "size": "xl",
        "wrap": true
      },
      {
        "type": "text",
        "text": "จ่ายเงินรางวัล {{amount}}JPYC ไปยัง {{wallet_address}} แล้ว\nตอนนี้เชิญเพื่อนด้วยตัวเอง\nแล้วรับของขวัญลูกบอลนำโชคเพิ่มได้อีก!\nมอบลูกบอลนำโชคให้เพื่อนมากขึ้น\nอย่าพลาดโอกาสลุ้นรับ JPYC มูลค่าสูงสุด 50,000 เยน",
        "size": "sm",
        "color": "#999999",
        "wrap": true,
        "margin": "md"
      }
    ]
  },
  "footer": {
    "type": "box",
    "layout": "vertical",
    "spacing": "sm",
    "contents": [
      {
        "type": "button",
        "style": "link",
        "height": "sm",
        "action": {
          "type": "uri",
          "label": "ชวนเพื่อน",
          "uri": "{{ACTION_URL}}"
        }
      },
      {
        "type": "button",
        "style": "link",
        "height": "sm",
        "action": {
          "type": "uri",
          "label": "ยืนยัน",
          "uri": "{{ACTION_URL}}"
        }
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [],
        "margin": "sm"
      }
    ],
    "flex": 0
  }
}