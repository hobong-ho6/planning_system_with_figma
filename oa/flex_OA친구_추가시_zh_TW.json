{
  "type": "bubble",
  "hero": {
    "type": "image",
    "url": "{{IMAGE_URL}}",
    "size": "full",
    "aspectRatio": "20:13",
    "aspectMode": "cover",
    "action": {
      "type": "uri",
      "uri": "{{ACTION_URL}}"
    }
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "必做任務獎金\n{{amount}}JPYC 發放完成",
        "weight": "bold",
        "size": "xl",
        "wrap": true
      },
      {
        "type": "text",
        "text": "獎金 {{amount}}JPYC 已發放至 {{wallet_address}}。",
        "size": "sm",
        "color": "#999999",
        "wrap": true,
        "margin": "md"
      }
    ]
  },
  "footer": {
    "type": "box",
    "layout": "vertical",
    "spacing": "sm",
    "contents": [
      {
        "type": "button",
        "style": "link",
        "height": "sm",
        "action": {
          "type": "uri",
          "label": "前往首頁",
          "uri": "{{ACTION_URL}}"
        }
      },
      {
        "type": "button",
        "style": "link",
        "height": "sm",
        "action": {
          "type": "uri",
          "label": "確認",
          "uri": "{{ACTION_URL}}"
        }
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [],
        "margin": "sm"
      }
    ],
    "flex": 0
  }
}