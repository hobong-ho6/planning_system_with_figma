{
  "type": "bubble",
  "hero": {
    "type": "image",
    "url": "{{product_image_url}}",
    "size": "full",
    "aspectRatio": "20:13",
    "aspectMode": "cover"
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "ซื้อสำเร็จแล้ว!",
        "weight": "bold",
        "size": "lg",
        "wrap": true
      },
      {
        "type": "box",
        "layout": "vertical",
        "margin": "md",
        "spacing": "sm",
        "contents": [
          {
            "type": "text",
            "text": "ตรวจสอบสินค้าแล้วใช้ได้ทันที",
            "size": "sm",
            "color": "#666666",
            "wrap": true
          }
        ]
      }
    ]
  },
  "footer": {
    "type": "box",
    "layout": "vertical",
    "spacing": "sm",
    "contents": [
      {
        "type": "button",
        "style": "primary",
        "color": "#000000",
        "height": "sm",
        "action": {
          "type": "uri",
          "label": "ตรวจสอบใน Unifi",
          "uri": "{{product_guidekim_url}}"
        }
      }
    ]
  }
}