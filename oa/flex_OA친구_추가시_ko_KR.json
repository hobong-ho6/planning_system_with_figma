{
  "type": "bubble",
  "hero": {
    "type": "image",
    "url": "{{IMAGE_URL}}",
    "size": "full",
    "aspectRatio": "20:13",
    "aspectMode": "cover",
    "action": {
      "type": "uri",
      "uri": "{{ACTION_URL}}"
    }
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "필수미션 당첨금\n{{amount}}JPYC 지급 완료",
        "weight": "bold",
        "size": "xl",
        "wrap": true
      },
      {
        "type": "text",
        "text": "당첨금 {{amount}}JPYC가 {{wallet_address}}로 지급되었습니다.",
        "size": "sm",
        "color": "#999999",
        "wrap": true,
        "margin": "md"
      }
    ]
  },
  "footer": {
    "type": "box",
    "layout": "vertical",
    "spacing": "sm",
    "contents": [
      {
        "type": "button",
        "style": "link",
        "height": "sm",
        "action": {
          "type": "uri",
          "label": "홈으로 가기",
          "uri": "{{ACTION_URL}}"
        }
      },
      {
        "type": "button",
        "style": "link",
        "height": "sm",
        "action": {
          "type": "uri",
          "label": "확인하기",
          "uri": "{{ACTION_URL}}"
        }
      },
      {
        "type": "box",
        "layout": "vertical",
        "contents": [],
        "margin": "sm"
      }
    ],
    "flex": 0
  }
}