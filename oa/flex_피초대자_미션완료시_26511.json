{
  "ko_KR": {
    "type": "flex",
    "altText": "Unifi 럭키볼 캠페인 알림",
    "contents": {
      "type": "bubble",
      "hero": {
        "type": "image",
        "url": "{{IMAGE_URL}}",
        "size": "full",
        "aspectRatio": "20:13",
        "aspectMode": "cover"
      },
      "body": {
        "type": "box",
        "layout": "vertical",
        "spacing": "md",
        "contents": [
          {
            "type": "text",
            "text": "친구 초대 완료!\n럭키볼 1개가 지급되었어요",
            "wrap": true,
            "weight": "bold",
            "size": "xl"
          },
          {
            "type": "text",
            "text": "* 당첨 보상은 즉시 지급됩니다. 최대 5분까지 소요됩니다.\n* 보상 지급일까지 Unifi LINE 공식계정 친구를 유지해야 JPYC를 받을 수 있습니다.",
            "wrap": true,
            "size": "sm",
            "color": "#888888"
          }
        ]
      },
      "footer": {
        "type": "box",
        "layout": "vertical",
        "spacing": "sm",
        "contents": [
          {
            "type": "button",
            "style": "primary",
            "action": {
              "type": "uri",
              "label": "뽑으러 가기",
              "uri": "{{ACTION_URL}}"
            }
          }
        ]
      }
    }
  },
